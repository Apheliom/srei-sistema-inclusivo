# ====================================================================
# CONFIGURACIÓN DE CORREO SMTP GRATUITO - SREI WEB
# ====================================================================

# OPCIÓN B: BREVO (300 correos/día 100% gratis - Recomendado)
# Crea tu cuenta gratuita en https://app.brevo.com
# Ve a: Configuración -> SMTP y Claves API -> Generar una nueva clave SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo_de_registro_en_brevo@gmail.com
SMTP_PASS=tu_clave_smtp_master_de_brevo
SMTP_FROM="SREI Educación Inclusiva" <tu_correo_de_registro_en_brevo@gmail.com>

# OPCIÓN ALTERNATIVA: GMAIL SMTP DIRECTO (500 correos/día gratis)
# Requiere cuenta Gmail con 2FA y Contraseña de Aplicación (https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="SREI Educación Inclusiva" <tu_correo@gmail.com>

PORT=3000
